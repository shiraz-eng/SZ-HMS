# Root domain used by middleware to parse tenant subdomains in production.
NEXT_PUBLIC_ROOT_DOMAIN=szhms.com
# In local dev, hit http://demo.localhost:3001 or just http://localhost:3001/demo

# Must match packages/database/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/szhms?schema=public"

# Session signing key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-0123456789abcdef0123456789abcdef"
