# Local dev: use Neon's DIRECT endpoint (no `-pooler` in the host) — it is
# stable for a long-lived Node process. Or run local Postgres:
#   docker run --name szhms-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# On Vercel (serverless): use Neon's POOLED endpoint (`-pooler` host) and add
# `&pgbouncer=true` so Prisma disables prepared statements for PgBouncer:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
